{
  "name": "ipv-cri-ob-front",
  "version": "1.0.0",
  "description": "Open Banking Credential Issuer Frontend",
  "homepage": "https://github.com/govuk-one-login/ipv-cri-ob-front#readme",
  "bugs": {
    "url": "https://github.com/govuk-one-login/ipv-cri-ob-front/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/govuk-one-login/ipv-cri-ob-front.git"
  },
  "license": "MIT",
  "author": "ipv-cri-lime",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check-translation": "node node_modules/@govuk-one-login/di-ipv-cri-common-express/scripts/checkTranslations.js '../../../../src/locales'",
    "dev": "NODE_ENV=development tsx watch src/index.ts | pino-pretty",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run --project unit --coverage",
    "test:infra": "vitest run --project infra",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:browser": "playwright test --config test/browser/playwright.mock.config.ts",
    "test:browser:ui": "playwright test --config test/browser/playwright.mock.config.ts --ui",
    "type-check": "tsc --noEmit && tsc --noEmit -p test"
  },
  "devDependencies": {
    "@aws-sdk/credential-provider-node": "3.972.45",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.60.0",
    "@smithy/signature-v4": "5.6.2",
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.2",
    "@types/govuk-frontend": "5.11.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "25.9.1",
    "@types/nunjucks": "3.2.6",
    "@types/supertest": "7.2.1",
    "@types/ua-parser-js": "0.7.39",
    "@vitest/coverage-v8": "4.1.7",
    "eslint-plugin-perfectionist": "5.9.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.24.0",
    "pino-pretty": "13.1.3",
    "sass-embedded": "1.100.0",
    "supertest": "7.2.2",
    "testcontainers": "12.0.0",
    "tsx": "4.22.3",
    "typescript": "7.0.2",
    "vite": "8.0.16",
    "vite-plugin-static-copy": "4.1.0",
    "vitest": "4.1.7"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1054.0",
    "@govuk-one-login/di-ipv-cri-common-express": "16.2.2",
    "@govuk-one-login/frontend-analytics": "4.2.0",
    "@govuk-one-login/frontend-device-intelligence": "1.2.0",
    "@govuk-one-login/frontend-language-toggle": "2.2.2",
    "@govuk-one-login/frontend-ui": "5.3.1",
    "@govuk-one-login/frontend-vital-signs": "0.1.4",
    "connect-dynamodb": "3.0.5",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "express-session": "1.19.0",
    "govuk-frontend": "5.14.0",
    "nunjucks": "3.2.4",
    "ua-parser-js": "1.0.40",
    "zod": "4.4.3"
  },
  "overrides": {
    "hmpo-components": "8.0.6",
    "@govuk-one-login/frontend-language-toggle": "$@govuk-one-login/frontend-language-toggle",
    "@govuk-one-login/frontend-ui": "$@govuk-one-login/frontend-ui"
  }
}
