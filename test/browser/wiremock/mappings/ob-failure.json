      "request": {
        "method": "GET",
        "urlPath": "/banks",
        "headers": {
          "session_id": {
            "equalTo": "DEADB4NK"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": [
          {
            "bank_id": "ironforge-vault",
