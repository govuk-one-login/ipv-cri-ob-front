{
  "mappings": [
    {
      "name": "create session (failure path - banks unavailable)",
      "request": {
        "method": "POST",
        "url": "/session",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.request == 'test-jwt-failure')]" }]
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "session_id": "FA11FA11",
          "state": "sT@t3",
          "redirect_uri": "{{request.baseUrl}}/callback"
        },
        "transformers": ["response-template"]
      }
    },
    {
      "name": "get banks (failure path - 500)",
      "request": {
        "method": "GET",
        "urlPath": "/banks",
        "headers": {
          "session_id": {
            "equalTo": "FA11FA11"
          }
        }
      },
      "response": {
        "status": 500,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "message": "Internal server error",
          "code": "server_error"
        }
      }
    },
    {
      "name": "create session (all banks offline path)",
      "request": {
        "method": "POST",
        "url": "/session",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.request == 'test-jwt-all-banks-offline')]" }]
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "session_id": "DEADB4NK",
          "state": "sT@t3",
          "redirect_uri": "{{request.baseUrl}}/callback"
        },
        "transformers": ["response-template"]
      }
    },
    {
