        },
        "transformers": ["response-template"]
      }
    },
    {
      "name": "oauth callback (prove another way)",
      "request": {
        "method": "GET",
        "urlPath": "/callback",
        "queryParameters": {
          "code": {
            "equalTo": "ABORT-CODE"
          },
          "state": {
            "equalTo": "sT@t3"
          },
          "client_id": {
            "equalTo": "test-client"
