          {
            "bank_id": "org-counting-house",
            "friendly_name": "Orgrimmar Counting House",
            "is_sandbox": false,
            "service_status": false
          }
        ]
      }
    },
    {
      "name": "create session (prove another way path)",
      "request": {
        "method": "POST",
        "url": "/session",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.request == 'test-jwt-prove-another-way')]" }]
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "session_id": "AB0RTAB0",
          "state": "sT@t3",
          "redirect_uri": "{{request.baseUrl}}/callback"
        },
        "transformers": ["response-template"]
      }
    },
    {
      "name": "get banks (prove another way path)",
      "request": {
        "method": "GET",
        "urlPath": "/banks",
        "headers": {
          "session_id": {
            "equalTo": "AB0RTAB0"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
