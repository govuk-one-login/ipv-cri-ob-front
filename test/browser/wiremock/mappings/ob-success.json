{
  "mappings": [
    {
      "name": "create session",
      "request": {
        "method": "POST",
        "url": "/session",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.request == 'test-jwt-success')]" }]
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "session_id": "CAFEBABE",
          "state": "sT@t3",
          "redirect_uri": "{{request.baseUrl}}/callback"
        },
        "transformers": ["response-template"]
      }
    },
    {
      "name": "get authorization code",
      "request": {
        "method": "GET",
        "urlPath": "/authorization",
        "headers": {
          "session_id": {
            "equalTo": "CAFEBABE"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "authorizationCode": {
            "value": "DEADBEEF"
          },
          "redirect_uri": "{{request.baseUrl}}/callback",
          "state": "sT@t3"
        },
        "transformers": ["response-template"]
      }
    },
    {
      "name": "get banks",
      "request": {
        "method": "GET",
        "urlPath": "/banks",
        "headers": {
          "session_id": {
            "equalTo": "CAFEBABE"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": [
          {
            "bank_id": "ironforge-vault",
            "friendly_name": "Vault of Ironforge",
            "is_sandbox": false,
            "service_status": true
          },
          {
            "bank_id": "org-counting-house",
            "friendly_name": "Orgrimmar Counting House",
            "is_sandbox": false,
            "service_status": true
          },
          {
            "bank_id": "royal-bank-sw",
            "friendly_name": "Royal Bank of Stormwind",
            "is_sandbox": false,
            "service_status": true
          },
          {
            "bank_id": "forgotten-uldaman-vault",
            "friendly_name": "Forgotten Vault of Uldaman",
            "is_sandbox": false,
            "service_status": false
          }
        ]
      }
    },
    {
      "name": "create consent",
      "request": {
        "method": "POST",
        "urlPath": "/consent",
        "headers": {
          "session_id": {
            "equalTo": "CAFEBABE"
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "bank_consent_url": "http://{{systemValue type='ENVIRONMENT' key='CRI_BIND_HOST'}}:{{systemValue type='ENVIRONMENT' key='CRI_PORT'}}/stubs/webhook",
          "bank_id": "ironforge-vault",
          "id": "CONSENT-SUCCESS-UUID",
          "redirect_url": "http://{{systemValue type='ENVIRONMENT' key='CRI_BIND_HOST'}}:{{systemValue type='ENVIRONMENT' key='CRI_PORT'}}/confirm-details-bank"
        },
        "transformers": ["response-template"]
      }
    },
    {
      "name": "oauth callback",
      "request": {
        "method": "GET",
        "urlPath": "/callback",
        "queryParameters": {
          "code": {
            "equalTo": "DEADBEEF"
          },
          "state": {
            "equalTo": "sT@t3"
          },
          "client_id": {
            "equalTo": "test-client"
          }
        }
      },
      "response": {
        "status": 200,
        "body": "OAuth callback received successfully"
      }
    }
  ]
}
