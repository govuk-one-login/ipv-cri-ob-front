{
  "mappings": [
    {
      "name": "missing session-id fallback",
      "priority": 10,
      "request": {
        "method": "ANY",
        "urlPathPattern": ".*",
        "headers": {
          "session-id": { "absent": true }
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "error": "unauthorized",
          "message": "missing session-id"
        }
      }
    }
  ]
}
