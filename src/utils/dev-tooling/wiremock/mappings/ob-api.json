{
  "mappings": [
    {
      "name": "create session",
      "request": {
        "method": "POST",
        "url": "/session",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.request == 'test-jwt-success')]" }]
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "session_id": "{{randomValue type='UUID'}}",
          "state": "sT@t3",
          "redirect_uri": "{{request.baseUrl}}/callback"
        },
        "transformers": ["response-template"]
      }
    },
    {
      "name": "get authorization code",
      "request": {
        "method": "GET",
        "urlPath": "/authorization",
        "headers": {
          "session_id": {
            "matches": ".+"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "authorizationCode": {
            "value": "C1A551F1ED"
          },
          "redirect_uri": "{{request.baseUrl}}/callback",
          "state": "sT@t3"
        },
        "transformers": ["response-template"]
      }
    },
    {
      "name": "get banks",
      "request": {
        "method": "GET",
        "urlPath": "/banks",
        "headers": {
          "session_id": {
            "matches": ".+"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": [
          {
            "bank_id": "ironforge-vault",
            "friendly_name": "Vault of Ironforge",
            "is_sandbox": false,
            "service_status": true
          },
          {
            "bank_id": "org-counting-house",
            "friendly_name": "Orgrimmar Counting House",
            "is_sandbox": false,
            "service_status": true
          },
          {
            "bank_id": "royal-bank-sw",
            "friendly_name": "Royal Bank of Stormwind",
            "is_sandbox": false,
            "service_status": true
          },
          {
            "bank_id": "stranglethorn-trust-bank",
            "friendly_name": "Stranglethorn Trust Bank",
            "is_sandbox": false,
            "service_status": true
          },
          {
            "bank_id": "dalaran-merchant-bank",
            "friendly_name": "Dalaran Merchant Bank",
            "is_sandbox": false,
            "service_status": true
          },
          {
            "bank_id": "forgotten-uldaman-vault",
            "friendly_name": "Forgotten Vault of Uldaman",
            "is_sandbox": false,
            "service_status": false
          }
        ],
        "delayDistribution": {
          "type": "uniform",
          "lower": 100,
          "upper": 400
        }
      }
    },
    {
      "name": "create consent",
      "request": {
        "method": "POST",
        "urlPath": "/consent",
        "headers": {
          "session_id": {
            "matches": ".+"
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "bank_consent_url": "http://{{systemValue type='ENVIRONMENT' key='CRI_BIND_HOST'}}:{{systemValue type='ENVIRONMENT' key='CRI_PORT'}}/stubs/webhook",
          "bank_id": "{{jsonPath request.body '$.bank_id'}}",
          "id": "{{randomValue type='UUID'}}",
          "redirect_url": "http://{{systemValue type='ENVIRONMENT' key='CRI_BIND_HOST'}}:{{systemValue type='ENVIRONMENT' key='CRI_PORT'}}/confirm-details-bank"
        },
        "transformers": ["response-template"],
        "delayDistribution": {
          "type": "uniform",
          "lower": 100,
          "upper": 400
        }
      }
    },
    {
      "name": "missing session_id",
      "priority": 10,
      "request": {
        "method": "ANY",
        "urlPathPattern": "/(authorization|banks|consent)"
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "error": "missing_session_id",
          "message": "Start a session first (POST /session with { \"request\": \"test-jwt-success\" })."
        }
      }
    },
    {
      "name": "webhook sink",
      "request": {
        "method": "POST",
        "urlPath": "/webhook"
      },
      "response": {
        "status": 202
      }
    },
    {
      "name": "oauth callback",
      "request": {
        "method": "GET",
        "urlPath": "/callback",
        "queryParameters": {
          "code": {
            "equalTo": "DEADBEEF"
          },
          "state": {
            "equalTo": "sT@t3"
          },
          "client_id": {
            "equalTo": "test-client"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "OAuth callback received successfully"
      }
    },
    {
      "name": "oauth callback (error)",
      "request": {
        "method": "GET",
        "urlPath": "/callback",
        "queryParameters": {
          "error": {
            "matches": ".+"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "OAuth callback (error) received successfully"
      }
    }
  ]
}
