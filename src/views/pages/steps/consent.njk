{% extends "layouts/base.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}

{% set pageTitle = translate("pages.consent.title") %}
{% set isPageDataSensitive = true %}
{% set taxLevel1 = "web cri" %}
{% set taxLevel2 = "open banking" %}
{% set contentID = "c6054d22-9de5-4f3f-a65c-3aca495047ac" %}

{% block mainContent %}
  <h1 class="govuk-heading-l">{{ pageTitle }}</h1>
  {% for item in translate("pages.consent.content") %}
    {{ item | safe }}
  {% endfor %}
  <form method="post">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    {{
      govukCheckboxes({
        name: "consent",
        id: "consent",
        fieldset: {
          legend: {
            text: translate("pages.consent.checkbox.legendText"),
            isPageHeading: false,
            classes: "govuk-fieldset__legend--m"
          }
        },
        errorMessage: { text: formErrors["consent"] } if formErrors["consent"] else false,
        items: [
          {
            value: "consent",
            text: translate("pages.consent.checkbox.itemText")
          }
        ]
      })
    }}
    <div class="govuk-button-group">
      {% if isMobile %}
        {% set progressButtonTextOverride = translate("pages.consent.primaryButtonAlt") %}
      {% endif %}
      {% include "includes/progress-button.njk" %}
    </div>
    <p class="govuk-body">
      <a href="{{ proveAnotherWay }}" class="govuk-link govuk-link--no-visited-state">
        {{ translate("pages.consent.secondaryLink") }}
      </a>
    </p>
  </form>
{% endblock %}
